<Window x:Class="UniversalRecorder.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        WindowState="Maximized" ResizeMode="NoResize">
    <Grid>
        <InkCanvas x:Name="DrawCanvas" Background="Transparent" 
                   EditingMode="None"
                   MouseDown="DrawCanvas_MouseDown"
                   MouseMove="DrawCanvas_MouseMove"
                   MouseUp="DrawCanvas_MouseUp"/>
        <Canvas x:Name="EffectsCanvas" Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
</Window>